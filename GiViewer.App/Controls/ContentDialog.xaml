<ContentControl x:Class="GiViewer.App.Controls.ContentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GiViewer.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600">

    <Border CornerRadius="16"
            BorderThickness="1"
            Background="{DynamicResource ContentDialogBackground}"
            BorderBrush="{DynamicResource ContentDialogBorderBrush}">

        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Opacity="0.25"
                              BlurRadius="64"
                              ShadowDepth="0"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    Background="{DynamicResource ContentDialogTopOverlay}">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                        Name="DialogTitle"
                        Margin="24,24,24,6"
                        FontFamily="Segoe UI"
                        FontWeight="SemiBold"
                        FontSize="20"/>

                    <ContentPresenter Grid.Row="1"
                        Name="Presenter"
                        Margin="24,6,24,24"/>
                </Grid>
            </Border>

            <Separator Grid.Row="1"
                       BorderThickness="0,1,0,0"
                       BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}"/>

            <Grid Grid.Row="1" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 从右往左排列 -->
                <Button Name="Button1" Grid.Column="2" Height="36" MinWidth="96" Margin="0,8,20,8"/>
                <Button Name="Button2" Grid.Column="1" Height="36" MinWidth="96" Margin="0,8,20,8"/>
                <Button Name="Button3" Grid.Column="0" Height="36" MinWidth="96" Margin="20,8,20,8"/>
            </Grid>
        </Grid>
    </Border>
</ContentControl>
