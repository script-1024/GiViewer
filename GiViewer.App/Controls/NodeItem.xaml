<TreeViewItem x:Class="GiViewer.App.Controls.NodeItem"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:local="clr-namespace:GiViewer.App.Controls"
              xmlns:vm="clr-namespace:GiViewer.App.ViewModels"
              d:DataContext="{d:DesignInstance Type=vm:NodeItemViewModel}"
              mc:Ignorable="d" d:DesignHeight="16" d:DesignWidth="240"
              HorizontalContentAlignment="Stretch"
              IsExpanded="False" Header="{Binding}">

    <!-- 继承样式 -->
    <TreeViewItem.Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"/>
    </TreeViewItem.Style>
    
    <TreeViewItem.HeaderTemplate>
        <DataTemplate>
            <Grid HorizontalAlignment="Stretch" MinHeight="32" MaxHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 图标 -->
                <Viewbox Grid.Column="0" Margin="-6, 0, 0, 0" Width="16" Height="16">
                    <Path Name="Icon" Stretch="Uniform" Data="{Binding IconData}" Fill="{Binding IconBrush}"/>
                </Viewbox>
                
                <!-- 标签文本 -->
                <Label Grid.Column="1" Margin="6, 7, 6, 0" Content="{Binding Header}"/>
                
                <!-- 可选控件 -->
                <ContentPresenter Grid.Column="2" Margin="6, 0, 0, 0" Name="ContentPresenter" Content="{Binding Extra}"/>
            </Grid>
        </DataTemplate>
    </TreeViewItem.HeaderTemplate>
</TreeViewItem>
