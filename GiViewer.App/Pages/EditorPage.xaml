<Page x:Class="GiViewer.App.Pages.EditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lang="clr-namespace:GiViewer.App.Resources.Languages"
      xmlns:ctrl="clr-namespace:GiViewer.App.Controls"
      mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
      Title="EditorPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Name="Menu" Margin="6, 0, 6, 0">
            <MenuItem Tag="Menu.File">
                <MenuItem Tag="Menu.File.New" Click="MenuItem_Click"/>
                <MenuItem Tag="Menu.File.Open" Click="MenuItem_Click"/>
                <MenuItem Tag="Menu.File.Save" Click="MenuItem_Click"/>
                <MenuItem Tag="Menu.File.SaveAs" Click="MenuItem_Click"/>
                <Separator/>
                <MenuItem Tag="Menu.File.Close" Click="MenuItem_Click"/>
                <MenuItem Tag="Menu.File.Exit" Click="MenuItem_Click"/>
            </MenuItem>
        </Menu>

        <ctrl:Editor Grid.Row="1" x:Name="Editor"/>
    </Grid>
</Page>
