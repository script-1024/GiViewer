<Window x:Class="GiViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GiViewer.App"
        mc:Ignorable="d"
        Title="GiViewer" MinHeight="360" MinWidth="480"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">

    <Grid Name="XamlRoot">
        <!-- 窗体内容 -->
        <Frame Name="ContentFrame" Source="Pages/EditorPage.xaml"/>
        
        <!-- 对话框 -->
        <Grid Name="GrayMask" Visibility="Hidden">
            <Rectangle Name="SmokeFill" Fill="{DynamicResource ContentDialogSmokeFill}" MouseDown="CloseDialog"/>
            <Border Name="DialogWrapper" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
